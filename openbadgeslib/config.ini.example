;
; OpenBadges Lib configuration example for RSA keys.
;

; Paths to the keys and log
[paths]
base         = .
base_key     = ${base}/keys
base_log     = ${base}/log
base_image   = ${base}/images
; OpenBadges 3.0 status registries (issued credential -> status list index)
base_status  = ${base}/status

; Log configuration. Stored in ${base_log}
[logs]
general = general.log
signer  = signer.log

; SMTP Configuration
[smtp]
smtp_server = localhost
smtp_port = 25
use_ssl = False
mail_from = no-reply@issuer.badge
; Uncomment these and set use_ssl = True if your SMTP server needs authentication
;username =
;password =

; Configuration of the OpenBadges issuer.
; Every URL here and in the badge sections is public: it is printed by the
; tools, published in the badge metadata and embedded in signed credentials.
; A URL that embeds credentials (https://user:password@host/) is rejected when
; the config is loaded, so the password cannot leak into any of them. The rule
; is blunt on purpose: an '@' (or %40) ANYWHERE in one of those URLs is
; refused, because a password holding a '/' hides the '@' from the parser.
; Values that are not URLs (the e-mail below, local paths) are unaffected.
[issuer]
name           = OpenBadge issuer
url            = https://www.issuer.badge
image          = issuer_logo.png
email          = issuer_mail@issuer.badge
publish_url    = https://openbadges.issuer.badge/issuer/
revocationList = revoked.json
; OpenBadges 3.0 issuer identity. Unset: credentials name publish_url as the
; issuer. 'auto': derive a did:web DID from publish_url (openbadges-publish
; -V 3 generates the matching did.json). An explicit did:web:... is used as-is.
;did            = auto
; EUDI SD-JWT VC track (optional): an issuer-hosted vct URL, which must live
; under publish_url. openbadges-publish -V 3 then writes its SD-JWT VC Type
; Metadata into the published folder so wallets can resolve and validate
; SD-JWT badges. Unset: nothing is published and badges use the default
; imsglobal vct.
;sd_jwt_vct     = ${publish_url}vct/openbadge

; OpenID for Verifiable Credential Issuance (OID4VCI), issuer side. Optional and
; entirely opt-in: without this section nothing changes, and a badge is only
; offered over OID4VCI if its own 'oid4vci_formats' key says so.
;
; This library does NOT run the endpoints. It builds the offers, verifies the
; wallet's key proof (via openvc-core, the [oid4vci] extra) and issues the
; credential; you mount the routes in your own web framework at the URLs below.
;
; NOT a HAIP-conformant issuer: no DPoP, no key attestation checking, no client
; authentication and no authorization code flow. Pre-authorized code only.
;[oid4vci]
; The Credential Issuer Identifier: the https base URL where you serve
; /.well-known/openid-credential-issuer. Every wallet key proof binds its 'aud'
; to this exact string, so it must match what you actually serve. Default:
; [issuer] publish_url.
;credential_issuer   = https://openbadges.issuer.badge/issuer/
; The three endpoints you mount. Default: derived from credential_issuer.
;credential_endpoint = https://openbadges.issuer.badge/issuer/credential
;nonce_endpoint      = https://openbadges.issuer.badge/issuer/nonce
;token_endpoint      = https://openbadges.issuer.badge/issuer/token
; Where the flow's short-lived state lives (pre-authorized codes, access tokens,
; spent nonces). SQLite, single host: NOT on NFS/SMB, where its locking breaks.
; The directory is created 0700 and holds recipient PII — do not back it up.
; Default: ${paths:base}/oid4vci.sqlite3
;store_path          = ${paths:base}/oid4vci.sqlite3
; Lifetimes, in seconds. The offer TTL bounds how long a QR code stays
; redeemable; keep it short, it is a bearer secret.
;offer_ttl_s         = 600
;nonce_ttl_s         = 120
;token_ttl_s         = 300
; How stale a wallet's key proof may be before it is refused.
;proof_max_age_s     = 300
; Credentials one Credential Request may claim. Leave at 1 unless you have a
; reason: a batch mints one credential per key proof off a single grant.
;batch_size          = 1
; The out-of-band PIN, when an offer asks for one. 'numeric' or 'text'.
;tx_code_length      = 6
;tx_code_input_mode  = numeric

;Badge configuration sections.
[badge_1]
name        = Badge 1
description = Given to any user that install this library
local_image = image_badge1.svg
image       = https://www.issuer.badge/issuer/badge_1/badge1.svg
criteria    = https://www.issuer.badge/issuer/badge_1/criteria.html
; OpenBadges 3.0 achievement criteria narrative (free text). Falls back to the
; 'criteria' URL above when unset, which is rarely what you want in a
; credential a human reads.
;criteria_narrative = Awarded to anyone who installs this library
verify_key  = https://www.issuer.badge/issuer/badge_1/verify_rsa_key.pem
badge       = https://www.issuer.badge/issuer/badge_1/badge.json
; OpenBadges 2.0 (-V 2): URL of this badge's CryptographicKey JSON-LD document
; (published by openbadges-publish as <badge>/key.json). Used as verification.creator.
crypto_key  = https://www.issuer.badge/issuer/badge_1/key.json
; OpenBadges 2.0 hosted mode (openbadges-signer -V 2 -H): base URL under which
; per-recipient hosted assertion JSON files are published for verification.
hosted_assertions_base = https://www.issuer.badge/issuer/badge_1/assertions/
private_key = ${paths:base_key}/sign_rsa_key_1.pem
public_key  = ${paths:base_key}/verify_rsa_key_1.pem
; key_type selects the algorithm for openbadges-keygenerator: RSA (default), ECC, or ED25519
key_type    = RSA
; OpenBadges 3.0 proof format: vc-jwt (compact JWT-VC, the default) or ldp
; (embedded W3C Data Integrity proof, cryptosuite eddsa-rdfc-2022). ldp needs
; key_type = ED25519 and the [ldp] extra (pip install openbadgeslib[ldp]).
;proof_format = vc-jwt
; OpenBadges 3.0 credential status (opt-in). When set, openbadges-signer -V 3
; attaches credentialStatus entries for these purposes (comma-separated subset
; of: revocation, suspension) and openbadges-publish -V 3 generates the signed
; Bitstring Status Lists to host under status_base.
;status_lists     = revocation, suspension
; Bitstring capacity; the default is the W3C spec minimum. Can be grown later,
; never shrunk.
;status_size_bits = 131072
; Public base URL of this badge's status lists (<status_base><purpose>.jwt).
; Default: ${issuer:publish_url}badge_1/
;status_base      = https://openbadges.issuer.badge/issuer/badge_1/
; STRONGLY RECOMMENDED for revocable badges: freshness window (in days) stamped
; on each published list as validUntil. Without it a list has NO anti-replay
; protection — a verifier can't tell a replayed older copy (with fewer
; revocations) from the current one, so a revoked badge could be resurrected.
; You MUST republish the lists (openbadges-publish -V 3) before the window
; lapses; pick a cadence you can sustain (e.g. 7 => weekly). Unset = no bound
; (offline-friendly, but publishes a loud warning).
;status_validity_days = 7
; OID4VCI opt-in for this badge (comma-separated subset of: jwt_vc_json,
; vc+sd-jwt). Unset means the badge is not published in the issuer metadata and
; cannot be offered to a wallet. jwt_vc_json is revocable via the status lists
; above; vc+sd-jwt is the EUDI track and is IRREVOCABLE, so it cannot be
; combined with status_lists. vc+sd-jwt also needs key_type = ED25519 or ECC.
;oid4vci_formats  = jwt_vc_json
; Demand a key attestation from the wallet (OID4VCI 1.0 §12.2.4). Unset is
; the spec default: the parameter MUST NOT appear unless you actually
; require one, or software wallets are locked out. true / {} = required
; with no extra constraints; a JSON object is the Appendix D.2 set.
; Advertising this also refuses a proof without key_attestation before
; the nonce is spent — do not publish it and then accept inline-jwk proofs.
;oid4vci_key_attestations_required = true
;mail        = ${paths:base}/badge_1_mail.txt

[badge_2]
name        = Badge 2
description = Given to any user that promote the library
local_image = image_badge2.svg
image       = https://www.issuer.badge/issuer/badge_2/badge2.svg
criteria    = https://www.issuer.badge/issuer/badge_2/criteria.html
verify_key  = https://www.issuer.badge/issuer/badge_2/verify_rsa_key.pem
badge       = https://www.issuer.badge/issuer/badge_2/badge.json
crypto_key  = https://www.issuer.badge/issuer/badge_2/key.json
hosted_assertions_base = https://www.issuer.badge/issuer/badge_2/assertions/
private_key = ${paths:base_key}/sign_rsa_key_2.pem
public_key  = ${paths:base_key}/verify_rsa_key_2.pem
key_type    = RSA
;mail       = ${paths:base}/badge_2_mail.txt
